---
const principios = [
	{
		numero: "01",
		titulo: "Diseño de Sistemas",
		descripcion:
			"Diseñar sistemas pensando en evolución, mantenibilidad, resiliencia y escalabilidad.",
	},
	{
		numero: "02",
		titulo: "Sistemas Distribuidos",
		descripcion:
			"Trabajar con comunicación asíncrona, eventos, consistencia y desacoplamiento entre servicios.",
	},
	{
		numero: "03",
		titulo: "Cloud",
		descripcion:
			"Construir soluciones aprovechando servicios cloud-native y principios de arquitectura modernos.",
	},
	{
		numero: "04",
		titulo: "Decisiones Técnicas",
		descripcion:
			"Analizar trade-offs, documentar decisiones y elegir soluciones pensando en el contexto del sistema.",
	},
	{
		numero: "05",
		titulo: "Seguridad",
		descripcion:
			"Considerar seguridad, autenticación, autorización y protección de datos como parte del diseño y no como una etapa posterior.",
	},
	{
		numero: "06",
		titulo: "Mantenibilidad",
		descripcion:
			"Buscar soluciones claras y sostenibles, donde las decisiones técnicas permitan que otros desarrolladores puedan entender y evolucionar el sistema.",
	},
];
---

<section id="architecture">
	<div class="architecture-header">
		<p>Arquitectura</p>

		<h2>
			No solo escribo código.
			<br />
			Pienso en cómo funciona
			<br />
			el sistema completo.
		</h2>
	</div>

	<div class="architecture-grid">
		{
			principios.map((principio) => (
				<article>
					<span>{principio.numero}</span>

					<div>
						<h3>{principio.titulo}</h3>

						<p>{principio.descripcion}</p>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	#architecture {
		padding: 180px 48px;

		border-top: 1px solid var(--border);
	}

	.architecture-header {
		max-width: 1200px;
		margin: 0 auto 120px;
	}

	.architecture-header > p {
		margin: 0 0 48px;

		font-size: var(--text-sm);
		font-weight: var(--weight-medium);

		text-transform: uppercase;
		letter-spacing: 0.15em;

		color: var(--accent);
	}

	.architecture-header h2 {
		max-width: 1000px;

		margin: 0;

		font-size: clamp(3rem, 7vw, 7rem);
		line-height: 0.95;

		font-weight: var(--weight-regular);
		letter-spacing: -0.05em;
	}

	.architecture-grid {
		max-width: 1200px;
		margin: 0 auto;

		display: grid;
		grid-template-columns: repeat(2, 1fr);

		gap: 1px;

		background: var(--border);
	}

	.architecture-grid article {
		min-height: 280px;

		padding: 48px;

		display: flex;
		flex-direction: column;
		justify-content: space-between;

		background: var(--background);

		transition:
			transform 0.3s ease,
			background 0.3s ease;
	}

	.architecture-grid article:hover {
		transform: translateY(-4px);

		background: rgba(125, 211, 252, 0.025);
	}

	.architecture-grid span {
		font-size: var(--text-xs);

		color: var(--accent);

		letter-spacing: 0.08em;

		transition: color 0.25s ease;
	}

	.architecture-grid h3 {
		margin: 60px 0 0;

		font-size: 1.5rem;
		font-weight: var(--weight-regular);

		letter-spacing: -0.02em;

		transition: color 0.25s ease;
	}

	.architecture-grid article:hover h3 {
		color: var(--accent);
	}

	.architecture-grid p {
		max-width: 500px;

		margin: 16px 0 0;

		line-height: 1.7;

		color: var(--muted);
	}

	@media (max-width: 768px) {
		#architecture {
			padding: 100px 24px;
		}

		.architecture-header {
			margin-bottom: 80px;
		}

		.architecture-header h2 {
			font-size: clamp(2.5rem, 11vw, 4rem);
		}

		.architecture-grid {
			grid-template-columns: 1fr;
		}

		.architecture-grid article {
			min-height: 240px;
			padding: 32px;
		}
	}
</style>