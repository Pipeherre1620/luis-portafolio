---
import LogoCap from "./LogoCap.astro";
---

<section id="hero">
	<!-- Fondo de Plano Arquitectónico (Blueprint Grid + Noise) -->
	<div class="hero-bg-grid" aria-hidden="true"></div>
	<div class="hero-glow" aria-hidden="true"></div>

	<div class="hero-container">
		<!-- Columna Izquierda: Información y Terminal CLI -->
		<div class="hero-content">
			<!-- Pill de Estado -->
			<div class="status-badge">
				<span class="status-dot"></span>
				<span class="status-text">TECHNICAL LEADER • CLOUD & BACKEND ARCHITECT</span>
			</div>

			<h1>
				Luis Felipe
				<br />
				<span class="text-accent">Herreño</span>
			</h1>

			<p class="hero-description">
				Construyo arquitecturas cloud evolutivas, sistemas distribuidos de alto rendimiento y productos digitales de impacto.
			</p>

			<!-- Mini Terminal de Arquitectura -->
			<div class="hero-terminal">
				<div class="terminal-bar">
					<div class="terminal-dots">
						<span class="tdot tdot-red"></span>
						<span class="tdot tdot-yellow"></span>
						<span class="tdot tdot-green"></span>
					</div>
					<span class="terminal-title">pipe@systems: ~/stack</span>
				</div>
				<div class="terminal-body">
					<div class="terminal-line">
						<span class="t-prompt">❯</span>
						<span class="t-cmd">arch-env</span>
						<span class="t-flag">--core-stack</span>
					</div>
					<div class="cli-tags">
						<span class="tag">Java</span>
						<span class="tag">Spring Boot</span>
						<span class="tag">AWS</span>
						<span class="tag">PostgreSQL</span>
						<span class="tag">Python</span>
						<span class="cursor-blink">_</span>
					</div>
				</div>
			</div>

			<!-- Botones de Acción -->
			<div class="hero-actions">
				<a href="#experience" class="btn-primary">
					<span>Experiencia</span>
					<span class="arrow">↗</span>
				</a>
				<a href="#contact" class="btn-secondary">
					<span>Contacto</span>
				</a>
			</div>
		</div>

		<!-- Columna Derecha: Tarjeta Fotográfica Limpia con Overlay -->
		<div class="hero-image-container">
			<div class="hero-card" id="hero-interactive-card">
				<!-- Marco de Fotografía de Alta Calidad -->
				<div class="image-frame">
					<img
						src="/images/luis-paramo.jpeg"
						alt="Luis Felipe Herreño - Software Architect"
					/>
				</div>

				<!-- Badge Flotante Glassmorphism con Isotipo de Marca {/} -->
				<div class="card-glass-badge">
					<div class="badge-icon">
						<LogoCap size={32} idPrefix="hero-card-cap" />
					</div>
					<div class="badge-info">
						<span class="badge-title">Backend & Cloud Lead</span>
						<span class="badge-sub">Distributed & Event-Driven Systems</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Teaser Horizontal Inferior (Footprint de Arquitectura) -->
	<div class="hero-footer-teaser">
		<div class="teaser-item">
			<span class="teaser-num">01</span>
			<span class="teaser-text">Monolith to Event-Driven Microservices</span>
		</div>
		<div class="teaser-divider"></div>
		<div class="teaser-item">
			<span class="teaser-num">02</span>
			<span class="teaser-text">AWS Data Lake & Analytics Infrastructure</span>
		</div>
		<div class="teaser-divider"></div>
		<div class="teaser-item">
			<span class="teaser-num">03</span>
			<span class="teaser-text">Domain-Driven Design & Clean Code</span>
		</div>
	</div>
</section>

<style>
	#hero {
		position: relative;
		min-height: calc(100vh - 80px);
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: center;
		padding: 60px 48px 30px;
		background-color: var(--background);
		box-sizing: border-box;
		overflow: hidden;
	}

	/* Fondo estilo Blueprint / Cuadrícula de ingeniería */
	.hero-bg-grid {
		position: absolute;
		inset: 0;
		background-size: 50px 50px;
		background-image: 
			linear-gradient(to right, rgba(240, 246, 252, 0.03) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(240, 246, 252, 0.03) 1px, transparent 1px);
		pointer-events: none;
		z-index: 0;
	}

	/* Glow sutil en el fondo detrás de la tarjeta */
	.hero-glow {
		position: absolute;
		top: 20%;
		right: 15%;
		width: 450px;
		height: 450px;
		background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	/* Grid Principal */
	.hero-container {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1200px;
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		align-items: center;
		gap: 60px;
		margin: auto 0;
	}

	/* Status Badge */
	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		background: var(--accent-glow-subtle);
		border: 1px solid var(--border-hover);
		border-radius: 20px;
		margin-bottom: 24px;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		background-color: var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 10px var(--accent);
		animation: pulseDot 2s infinite alternate;
	}

	.status-text {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--foreground);
		opacity: 0.9;
	}

	/* Tipografía */
	#hero h1 {
		margin: 0 0 20px 0;
		font-size: clamp(3.5rem, 6vw, 6.8rem);
		line-height: 0.92;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: var(--foreground);
	}

	.text-accent {
		color: var(--accent);
	}

	.hero-description {
		max-width: 520px;
		margin: 0 0 32px 0;
		font-size: 1.1rem;
		line-height: 1.65;
		color: var(--muted);
	}

	/* CLI Terminal Component */
	.hero-terminal {
		display: flex;
		flex-direction: column;
		background: rgba(22, 27, 34, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--border);
		border-radius: 10px;
		max-width: 540px;
		margin-bottom: 36px;
		overflow: hidden;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.hero-terminal:hover {
		border-color: var(--border-hover);
		box-shadow: 0 14px 30px rgba(56, 189, 248, 0.12);
	}

	.terminal-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 8px 14px;
		background: #11161D;
		border-bottom: 1px solid var(--border);
	}

	.terminal-dots {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.tdot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
	}

	.tdot-red { background: #FF5F56; }
	.tdot-yellow { background: #FFBD2E; }
	.tdot-green { background: #27C93F; }

	.terminal-title {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}

	.terminal-body {
		padding: 12px 16px;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.terminal-line {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 10px;
	}

	.t-prompt {
		color: var(--accent);
		font-weight: bold;
	}

	.t-cmd {
		color: var(--foreground);
		font-weight: 500;
	}

	.t-flag {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.cli-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	.tag {
		color: var(--muted);
		background: rgba(240, 246, 252, 0.05);
		padding: 3px 10px;
		border-radius: 4px;
		border: 1px solid transparent;
		transition: all 0.25s ease;
	}

	.tag:hover {
		color: var(--accent);
		border-color: var(--border-hover);
		background: var(--accent-glow-subtle);
		transform: translateY(-2px);
	}

	.cursor-blink {
		color: var(--accent);
		font-weight: bold;
		animation: blinkCursor 1s infinite steps(2, start);
	}

	@keyframes blinkCursor {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	/* Botones */
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 12px 24px;
		background: var(--accent);
		color: #0d1117;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		border-radius: 6px;
		box-shadow: 0 4px 18px var(--accent-glow);
		transition: all 0.25s ease;
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		background: var(--accent-hover);
		box-shadow: 0 6px 24px rgba(56, 189, 248, 0.45);
		gap: 14px;
	}

	.btn-secondary {
		padding: 12px 22px;
		color: var(--muted);
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: none;
		border-radius: 6px;
		border: 1px solid var(--border);
		transition: all 0.25s ease;
	}

	.btn-secondary:hover {
		color: var(--foreground);
		border-color: var(--border-hover);
		background: var(--surface);
	}

	/* Tarjeta de Foto Limpia */
	.hero-image-container {
		display: flex;
		justify-content: center;
		perspective: 1000px;
	}

	.hero-card {
		position: relative;
		width: 100%;
		max-width: 340px;
		transform-style: preserve-3d;
		transition: transform 0.2s ease-out;
		will-change: transform;
	}

	.image-frame {
		width: 100%;
		aspect-ratio: 4 / 5;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
		background-color: var(--surface-card);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.hero-card:hover .image-frame {
		border-color: var(--border-hover);
		box-shadow: 0 25px 50px rgba(56, 189, 248, 0.15);
	}

	.image-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.9) contrast(1.05);
		transition: transform 0.5s ease, filter 0.5s ease;
	}

	.hero-card:hover .image-frame img {
		transform: scale(1.03);
		filter: saturate(1.05) contrast(1.1);
	}

	/* Badge Glassmorphism */
	.card-glass-badge {
		position: absolute;
		bottom: -20px;
		left: -20px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 18px;
		background: rgba(22, 27, 34, 0.85);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid var(--border-hover);
		border-radius: 10px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.hero-card:hover .card-glass-badge {
		transform: translateZ(20px);
		box-shadow: 0 15px 35px rgba(56, 189, 248, 0.2);
	}

	.badge-icon {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.badge-info {
		display: flex;
		flex-direction: column;
	}

	.badge-title {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--foreground);
	}

	.badge-sub {
		font-size: 0.72rem;
		color: var(--accent);
		font-family: var(--font-mono);
	}

	/* Footer Teaser del Hero */
	.hero-footer-teaser {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1200px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 24px;
		border-top: 1px solid var(--border);
		margin-top: 40px;
	}

	.teaser-item {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.teaser-num {
		font-family: var(--font-mono);
		color: var(--accent);
		font-weight: bold;
	}

	.teaser-text {
		color: var(--muted);
		transition: color 0.25s ease;
	}

	.teaser-item:hover .teaser-text {
		color: var(--foreground);
	}

	.teaser-divider {
		width: 1px;
		height: 20px;
		background: var(--border);
	}

	@keyframes pulseDot {
		0% { opacity: 0.4; }
		100% { opacity: 1; }
	}

	/* Responsive */
	@media (max-width: 960px) {
		#hero {
			padding: 40px 24px 20px;
		}

		.hero-container {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.hero-image-container {
			order: -1;
			justify-content: flex-start;
		}

		.hero-card {
			max-width: 280px;
		}

		.card-glass-badge {
			left: 10px;
			bottom: -15px;
		}

		.hero-footer-teaser {
			display: none;
		}
	}
</style>

<script>
	const heroCard = document.getElementById('hero-interactive-card');
	if (heroCard) {
		heroCard.addEventListener('mousemove', (e) => {
			const rect = heroCard.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			const centerX = rect.width / 2;
			const centerY = rect.height / 2;
			const rotateX = ((y - centerY) / centerY) * -6;
			const rotateY = ((x - centerX) / centerX) * 6;
			heroCard.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg)`;
		});

		heroCard.addEventListener('mouseleave', () => {
			heroCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
		});
	}
</script>