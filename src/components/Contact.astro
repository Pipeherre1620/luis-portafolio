---
import LogoCap from "./LogoCap.astro";
---

<section id="contact">
	<div class="contact-header">
		<p class="section-label">Contacto</p>
	</div>

	<div class="contact-content">
		<h2>¿Hablamos?</h2>

		<p>
			Si quieres hablar sobre tecnología, arquitectura de software,
			proyectos o simplemente intercambiar ideas, puedes encontrarme
			en estos espacios.
		</p>

		<div class="contact-links">
			<a
				href="https://mail.google.com/mail/?view=cm&fs=1&to=luifelipemateus2008@gmail.com"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span>Email</span>
				<span>↗</span>
			</a>

			<a
				href="https://www.linkedin.com/in/luis-felipe-herreño-mateus-412562244"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span>LinkedIn</span>
				<span>↗</span>
			</a>

			<a
				href="https://github.com/Pipeherre1620"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span>GitHub</span>
				<span>↗</span>
			</a>
		</div>
	</div>

	<footer>
		<div class="footer-brand">
			<LogoCap size={28} showText={true} text="PIPEHERRE" subtitle="PORTAFOLIO OFICIAL" idPrefix="footer-logo" />
		</div>
		<div class="footer-copy">
			<span>© 2026 Luis Felipe Herreño</span>
			<span class="footer-separator">•</span>
			<span class="footer-tagline">Architecting Evolutive Systems</span>
		</div>
	</footer>
</section>

<style>
	#contact {
		padding: 160px 48px 60px;

		border-top: 1px solid var(--border);
	}

	.contact-header {
		max-width: 1100px;

		margin: 0 auto 120px;
	}

	.section-label {
		margin: 0;

		font-size: var(--text-sm);
		font-weight: var(--weight-medium);

		text-transform: uppercase;
		letter-spacing: 0.12em;

		color: var(--accent);
	}

	.contact-content {
		max-width: 1100px;
		margin: 0 auto;
	}

	.contact-content h2 {
		margin: 0;

		font-size: clamp(4rem, 10vw, 10rem);
		line-height: 0.9;

		font-weight: var(--weight-medium);

		letter-spacing: -0.06em;
	}

	.contact-content > p {
		max-width: 520px;

		margin: 60px 0 100px;

		font-size: var(--text-lg);
		line-height: 1.7;

		color: var(--muted);
	}

	.contact-links {
		max-width: 700px;
	}

	.contact-links a {
		display: flex;
		justify-content: space-between;
		align-items: center;

		padding: 24px 0;

		border-top: 1px solid var(--border);

		color: var(--foreground);
		text-decoration: none;

		font-size: 1.1rem;

		transition:
			padding 0.3s ease,
			color 0.25s ease;
	}

	.contact-links a:last-child {
		border-bottom: 1px solid var(--border);
	}

	.contact-links a:hover {
		padding-left: 16px;

		color: var(--accent);
	}

	.contact-links a span:last-child {
		color: var(--muted);

		transition:
			color 0.25s ease,
			transform 0.25s ease;
	}

	.contact-links a:hover span:last-child {
		color: var(--accent);

		transform: translate(4px, -4px);
	}

	footer {
		max-width: 1100px;
		margin: 160px auto 0;
		padding-top: 32px;

		display: flex;
		align-items: center;
		justify-content: space-between;

		border-top: 1px solid var(--border);
		font-size: var(--text-xs);
		color: var(--muted);
	}

	.footer-brand {
		display: flex;
		align-items: center;
	}

	.footer-copy {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--muted);
	}

	.footer-separator {
		color: var(--border-hover);
	}

	.footer-tagline {
		color: var(--accent);
		font-family: var(--font-mono);
	}

	@media (max-width: 768px) {
		#contact {
			padding: 100px 24px 40px;
		}

		.contact-header {
			margin-bottom: 80px;
		}

		.contact-content h2 {
			font-size: clamp(3.5rem, 16vw, 6rem);
		}

		.contact-content > p {
			margin: 40px 0 70px;

			font-size: 1rem;
		}

		.contact-links {
			max-width: none;
		}

		.contact-links a {
			padding: 20px 0;
		}

		footer {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
			margin-top: 100px;
		}

		.footer-copy {
			flex-wrap: wrap;
		}
	}
</style>