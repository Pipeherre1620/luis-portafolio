---
const proyectos = [
	{
		numero: "01",
		titulo: "PIPEHERRE",
		categoria: "Portafolio personal",
		descripcion:
			"Sitio personal construido para documentar mi trayectoria, experiencia en ingeniería de software, proyectos y evolución hacia la arquitectura de sistemas.",
		tecnologias: [
			"Astro",
			"TypeScript",
			"HTML",
			"CSS",
		],
	},
	{
		numero: "02",
		titulo: "QuickTicket",
		categoria: "Laboratorio de arquitectura",
		descripcion:
			"POC desarrollado como ejercicio práctico de arquitectura evolutiva, explorando comunicación asíncrona, eventos y separación de responsabilidades entre servicios.",
		tecnologias: [
			"Java",
			"Spring Boot",
			"RabbitMQ",
			"PostgreSQL",
			"Docker",
		],
	},
];
---

<section id="projects">
	<div class="section-header">
		<p class="section-label">Proyectos</p>
	</div>

	<div class="projects-list">
		{
			proyectos.map((proyecto) => (
				<article class="project">
					<div class="project-number">
						<p>{proyecto.numero}</p>
					</div>

					<div class="project-content">
						<p class="category">{proyecto.categoria}</p>

						<h2>{proyecto.titulo}</h2>

						<p class="description">
							{proyecto.descripcion}
						</p>

						<div class="technologies">
							{
								proyecto.tecnologias.map((tecnologia) => (
									<span>{tecnologia}</span>
								))
							}
						</div>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	#projects {
		padding: 120px 48px;
		border-top: 1px solid var(--border);
	}

	.section-header {
		max-width: 1100px;
		margin: 0 auto 100px;
	}

	.section-label {
		margin: 0;

		font-size: var(--text-sm);
		font-weight: var(--weight-medium);

		text-transform: uppercase;
		letter-spacing: 0.12em;

		color: var(--accent);
	}

	.projects-list {
		max-width: 1100px;
		margin: 0 auto;
	}

	.project {
		display: grid;
		grid-template-columns: 100px 1fr;
		gap: 60px;

		padding: 70px 0;

		border-top: 1px solid var(--border);

		transition:
			padding 0.3s ease,
			transform 0.3s ease;
	}

	.project:last-child {
		border-bottom: 1px solid var(--border);
	}

	.project:hover {
		padding-left: 20px;
	}

	.project-number p {
		margin: 0;

		font-size: var(--text-xs);

		color: var(--accent);

		letter-spacing: 0.08em;

		transition: color 0.25s ease;
	}

	.category {
		margin: 0 0 16px;

		font-size: var(--text-xs);

		color: var(--muted);

		text-transform: uppercase;
		letter-spacing: 0.12em;
	}

	.project h2 {
		margin: 0;

		font-size: clamp(2.5rem, 6vw, 6rem);
		line-height: 0.95;

		font-weight: var(--weight-medium);

		letter-spacing: -0.05em;

		transition: color 0.3s ease;
	}

	.project:hover h2 {
		color: var(--accent);
	}

	.description {
		max-width: 650px;

		margin: 28px 0 0;

		font-size: var(--text-lg);
		line-height: 1.7;

		color: var(--muted);
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		align-items: center;

		gap: 10px;

		margin-top: 32px;
	}

	.technologies span {
		display: inline-block;

		padding: 8px 14px;

		border: 1px solid var(--border);

		font-size: var(--text-xs);
		line-height: 1;

		color: var(--muted);

		white-space: nowrap;

		transition:
			color 0.25s ease,
			border-color 0.25s ease,
			background 0.25s ease;
	}

	.technologies span:hover {
		color: var(--accent);

		border-color: var(--accent);

		background: rgba(125, 211, 252, 0.05);
	}

	@media (max-width: 768px) {
		#projects {
			padding: 80px 24px;
		}

		.section-header {
			margin-bottom: 60px;
		}

		.project {
			grid-template-columns: 1fr;
			gap: 20px;

			padding: 50px 0;
		}

		.project:hover {
			padding-left: 0;
		}

		.project h2 {
			font-size: clamp(2.8rem, 15vw, 5rem);
		}

		.description {
			font-size: 1rem;
		}
	}
</style>