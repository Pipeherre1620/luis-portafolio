---
const experiencias = [
	{
		periodo: "2024 — PRESENTE",
		cargo: "Líder Técnico",
		empresa: "Periferia IT",
		contexto: "Soluciones financieras · BRE-B",
		descripcion:
			"Liderazgo técnico en la implementación de soluciones para el ecosistema BRE-B, participando en integraciones con entidades financieras, flujos transaccionales y gestión de llaves.",
		logros: [
			"Liderazgo técnico en el diseño e implementación de soluciones backend.",
			"Integración de servicios para pagos P2P, P2M, QR y transferencias.",
			"Implementación y gestión de mecanismos de llaves dentro de flujos transaccionales.",
			"Integración con diferentes componentes del ecosistema financiero.",
			"Participación en soluciones cloud utilizando servicios de AWS.",
		],
		tecnologias: ["Java", "Spring Boot", "AWS", "PostgreSQL"],
	},
	{
		periodo: "2022 — 2024",
		cargo: "Desarrollador Backend",
		empresa: "Periferia IT",
		contexto: "Modernización de plataforma financiera",
		descripcion:
			"Participación en el desarrollo backend y en la migración de servicios desde infraestructura on-premise hacia AWS, contribuyendo a la modernización y escalabilidad de la plataforma.",
		logros: [
			"Desarrollo y mantenimiento de servicios backend.",
			"Migración progresiva de componentes desde infraestructura on-premise hacia AWS.",
			"Adaptación de servicios para entornos cloud.",
			"Participación en iniciativas de modernización tecnológica.",
			"Implementación de soluciones orientadas a servicios.",
		],
		tecnologias: ["Java", "Spring Boot", "AWS", "Cloud"],
	},
];
---

<section id="experience">
	<div class="section-header">
		<p class="section-label">Experiencia</p>
	</div>

	<div class="experience-list">
		{
			experiencias.map((experiencia) => (
				<article class="experience-item">
					<div class="experience-meta">
						<p>{experiencia.periodo}</p>
					</div>

					<div class="experience-content">
						<h2>{experiencia.cargo}</h2>

						<p class="company">
							{experiencia.empresa} · {experiencia.contexto}
						</p>

						<p class="description">
							{experiencia.descripcion}
						</p>

						<ul>
							{experiencia.logros.map((logro) => (
								<li>{logro}</li>
							))}
						</ul>

						<div class="technologies">
							{
								experiencia.tecnologias.map((tecnologia) => (
									<span>{tecnologia}</span>
								))
							}
						</div>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	#experience {
		padding: 120px 48px;
		border-top: 1px solid var(--border);
	}

	.section-header {
		max-width: 1100px;
		margin: 0 auto 100px;
		color: var(--accent);
	}

	.section-label {
		margin: 0;

		font-size: var(--text-sm);
		font-weight: var(--weight-medium);

		text-transform: uppercase;
		letter-spacing: 0.12em;

		color: var(--accent);
	}

	.experience-list {
		max-width: 1100px;
		margin: 0 auto;
	}

	.experience-item {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 60px;

		padding: 60px 0;

		border-top: 1px solid var(--border);
	}

	.experience-item:last-child {
		border-bottom: 1px solid var(--border);
	}

	.experience-meta p {
		margin: 0;

		font-size: var(--text-xs);

		color: var(--muted);

		letter-spacing: 0.08em;
	}

	.experience-content h2 {
		margin: 0;

		font-size: clamp(2rem, 4vw, 4rem);
		line-height: 1;

		font-weight: var(--weight-medium);
		letter-spacing: -0.04em;

		transition: color 0.25s ease;
	}

	.experience-item:hover .experience-content h2 {
		color: var(--accent);
	}

	.company {
		margin: 16px 0 32px;

		font-size: var(--text-sm);
		color: var(--muted);
	}

	.description {
		max-width: 700px;

		margin: 0 0 28px;

		font-size: var(--text-lg);
		line-height: 1.7;

		color: var(--foreground);
	}

	ul {
		max-width: 700px;

		margin: 0;
		padding: 0;

		list-style: none;
	}

	li {
		position: relative;

		padding-left: 20px;
		margin-bottom: 10px;

		font-size: var(--text-sm);
		line-height: 1.6;

		color: var(--muted);
	}

	li::before {
		content: "—";

		position: absolute;
		left: 0;

		color: var(--accent);
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		align-items: center;

		gap: 10px;

		margin-top: 32px;
	}

	.technologies span {
		display: inline-block;

		padding: 8px 14px;

		border: 1px solid var(--border);

		font-size: var(--text-xs);
		line-height: 1;

		color: var(--muted);

		white-space: nowrap;

		transition:
			color 0.25s ease,
			border-color 0.25s ease,
			background 0.25s ease;
	}

	.technologies span:hover {
		color: var(--accent);

		border-color: var(--accent);

		background: rgba(125, 211, 252, 0.05);
	}

	@media (max-width: 768px) {
		#experience {
			padding: 80px 24px;
		}

		.section-header {
			margin-bottom: 60px;
		}

		.experience-item {
			grid-template-columns: 1fr;
			gap: 20px;

			padding: 40px 0;
		}

		.experience-content h2 {
			font-size: clamp(2.2rem, 12vw, 4rem);
		}

		.description {
			font-size: 1rem;
		}
	}
</style>