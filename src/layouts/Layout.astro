---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";


interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Luis Felipe Herreño | Software Engineer",
	description = "Software Engineer focused on cloud, backend and software architecture.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

    <body>
        <Navbar />

        <slot />
    </body>

</html>